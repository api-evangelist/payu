            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer 3e5cac39-7e38-4139-8fd6-30adc06a61bd"
              }
            ],
            "params": [
              {
                "name": "shopId",
                "value": "a1B2C3x",
                "type": "path",
                "description": "ShopId value generated by PayU assigned to Shop"
              }
            ]
          },
          "docs": "Retrieve your PayU shop balance, id, etc."
        }
      ]
    }
  ],
  "bundled": true
}