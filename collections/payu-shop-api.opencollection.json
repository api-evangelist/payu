{
  "opencollection": "1.0.0",
  "info": {
    "name": "PayU GPO Europe REST Authorize Shop API",
    "version": "2.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Shop",
        "type": "folder"
      },
      "items": [
        {
          "info": {
