                "description": "Order ID generated by the PayU system"
              }
            ]
          },
          "docs": "Retrieve the status and details of an order."
        },
        {
          "info": {
            "name": "Cancel an Order",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://secure.payu.com/api/v2_1/orders/:orderId",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer 3e5cac39-7e38-4139-8fd6-30adc06a61bd"
              }
            ],
            "params": [
              {
                "name": "orderId",
                "value": "WZHF5FFDRJ140731GUEST000P01",
                "type": "path",
                "description": "Order ID generated by the PayU system"
              }
            ]
          },
          "docs": "Cancel (reject) orders processed by the PayU system."
        },
        {
          "info": {
            "name": "Capture Authorized Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://secure.payu.com/api/v2_1/orders/:orderId/captures",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer 3e5cac39-7e38-4139-8fd6-30adc06a61bd"
              }
            ],
            "params": [
              {
                "name": "orderId",
                "value": "WZHF5FFDRJ140731GUEST000P01",
                "type": "path",
                "description": "Order ID generated by the PayU system"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Capture whole order and update its status to COMPLETED (ended)."
        },
        {
          "info": {
            "name": "(deprecated) Capture Authorized Order",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://secure.payu.com/api/v2_1/orders/:orderId/status",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer 3e5cac39-7e38-4139-8fd6-30adc06a61bd"
              }
            ],
            "params": [
              {
                "name": "orderId",
                "value": "WZHF5FFDRJ140731GUEST000P01",
                "type": "path",
                "description": "Order ID generated by the PayU system"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Capture an order and update its status to COMPLETED (ended)."
        },
        {
          "info": {
            "name": "Retrieve a Transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure.payu.com/api/v2_1/orders/:orderId/transactions",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer 3e5cac39-7e38-4139-8fd6-30adc06a61bd"
              }
            ],
            "params": [
              {
                "name": "orderId",
                "value": "WZHF5FFDRJ140731GUEST000P01",
                "type": "path",
                "description": "Order ID generated by the PayU system"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the details of transactions created for an order with specified `orderId`."
        }
      ]
    }
  ],
  "bundled": true
}