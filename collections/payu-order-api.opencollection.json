{
  "opencollection": "1.0.0",
  "info": {
    "name": "PayU GPO Europe REST Authorize Order API",
    "version": "2.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Order",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://secure.payu.com/api/v2_1/orders",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer 3e5cac39-7e38-4139-8fd6-30adc06a61bd"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new order request."
        },
        {
          "info": {
            "name": "Retrieve an Order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure.payu.com/api/v2_1/orders/:orderId",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer 3e5cac39-7e38-4139-8fd6-30adc06a61bd"
              }
            ],
            "params": [
              {
                "name": "orderId",
                "value": "WZHF5FFDRJ140731GUEST000P01",
